#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

PARALLEL_OPTION = $(filter parallel=%,$(DEB_BUILD_OPTIONS))
ifneq (,$(PARALLEL_OPTION))
	NUMJOBS = $(patsubst parallel=%,%,$(PARALLEL_OPTION))
	export NINJAJOBS = -j$(NUMJOBS)
endif

# Reduce memory consumption & parallelism on certain architectures
ifeq (armhf, $(DEB_HOST_ARCH))
	export LDFLAGS+=-Wl,--no-keep-memory
	export NINJAJOBS = -j2
endif

# arm64 builders have enough cores/memory for a 16-way chromium build
ifeq (arm64, $(DEB_HOST_ARCH))
	export NINJAJOBS = -j16
	export NINJAFLAGS = -j16
endif

ifeq (i386, $(DEB_HOST_ARCH))
	export LDFLAGS+=-Wl,--no-keep-memory
	export NINJAJOBS = -j2
endif

ifeq (loong64, $(DEB_HOST_ARCH))
	export LDFLAGS+=-Wl,--no-keep-memory -mno-relax
	export NINJAJOBS = -j2
	export NINJAFLAGS = -j2
endif

ifeq (sw64, $(DEB_HOST_ARCH))
	export LDFLAGS+=-Wl,--no-keep-memory
	export NINJAJOBS = -j2
	export NINJAFLAGS = -j2
	export NODE_OPTIONS="--jitless"
endif

ifeq (i386, $(DEB_HOST_ARCH_CPU))
	export DEB_CFLAGS_MAINT_APPEND = -msse -msse2
	export DEB_CXXFLAGS_MAINT_APPEND = -msse -msse2
endif

# enable ccache with corresponding build-profile
ifneq ($(filter ccache,$(DEB_BUILD_PROFILES)),)
	extra_cmake_args += -DQT_USE_CCACHE=ON
endif

%:
	dh $@ --buildsystem=cmake+ninja

touch_files = src/3rdparty/chromium/third_party/devtools-frontend/src/front_end/third_party/lighthouse/lighthouse-dt-bundle.js \
	      src/3rdparty/chromium/third_party/devtools-frontend/src/front_end/third_party/lighthouse/report-assets/report-generator.js

# Per-arch patches (same pattern as master): each architecture loads only
# its own patch set. support-loong64.patch and support-sw64.patch are NOT
# in debian/patches/series. NOTE: support-sw64.patch is layered on top of
# support-loong64.patch (shared V8/GN base), so sw64 loads base + sw64.
# A stamp file tracks the applied set because layered patches touch the
# same files, so per-patch `patch -R` probing cannot detect applied state;
# revert on clean follows the stamp in reverse order.
ifeq (loong64, $(DEB_HOST_ARCH))
	TARGET_PATCH = patch_loong64
else ifeq (sw64, $(DEB_HOST_ARCH))
	TARGET_PATCH = patch_sw64
endif

STAMP = .arch-patches-stamp

.PHONY: patch_loong64 patch_sw64
patch_loong64:
	@if [ "$$(cat $(STAMP) 2>/dev/null || echo none)" = "loong64" ]; then \
		echo "arch patches: loong64 already applied"; \
	elif [ "$$(cat $(STAMP) 2>/dev/null || echo none)" != "none" ]; then \
		echo "ERROR: tree patched for '$$(cat $(STAMP))', run debian/rules clean first" >&2; exit 1; \
	else \
		echo "arch patches: applying support-loong64.patch"; \
		patch -p1 < debian/patches/support-loong64.patch && \
		echo "arch patches: loong64 done" && echo loong64 > $(STAMP); \
	fi

patch_sw64:
	@if [ "$$(cat $(STAMP) 2>/dev/null || echo none)" = "sw64" ]; then \
		echo "arch patches: sw64 already applied"; \
	elif [ "$$(cat $(STAMP) 2>/dev/null || echo none)" = "loong64" ]; then \
		echo "arch patches: applying support-sw64.patch (on loong64 base)"; \
		patch -p1 < debian/patches/support-sw64.patch && \
		echo "arch patches: sw64 done" && echo sw64 > $(STAMP); \
	elif [ "$$(cat $(STAMP) 2>/dev/null || echo none)" != "none" ]; then \
		echo "ERROR: unknown patch stamp, run debian/rules clean first" >&2; exit 1; \
	else \
		echo "arch patches: applying support-loong64.patch (base for sw64)"; \
		patch -p1 < debian/patches/support-loong64.patch && \
		echo "arch patches: base applied, applying support-sw64.patch" && \
		patch -p1 < debian/patches/support-sw64.patch && \
		echo "arch patches: sw64 done" && echo sw64 > $(STAMP); \
	fi

override_dh_auto_clean:
	dh_auto_clean
	@if [ -f $(STAMP) ]; then \
		s=$$(cat $(STAMP)); \
		echo "reverting arch patches for $$s"; \
		if [ "$$s" = "sw64" ]; then patch -R -p1 < debian/patches/support-sw64.patch; fi; \
		if [ "$$s" = "loong64" ] || [ "$$s" = "sw64" ]; then patch -R -p1 < debian/patches/support-loong64.patch; fi; \
		rm -f $(STAMP); \
	fi
	# NOTE: do not blanket-delete *.orig/*.rej — the chromium rust vendor
	# tree carries legitimate tracked Cargo.toml.orig files.

# Apply arch patches BEFORE dh_update_autotools_config: it overwrites the
# bundled config.guess/config.sub with the system copies, and the arch
# patches edit those files — patching after that step makes patch see the
# system content and misjudge hunks as "previously applied" (same stage as
# the old series-based application, which ran via dpkg-source before dh).
override_dh_update_autotools_config: $(TARGET_PATCH)
	dh_update_autotools_config

# Turn on system FFmpeg libraries for 6.3
override_dh_auto_configure:
	dh_auto_configure -- \
		--log-level=STATUS \
		-DCMAKE_LIBRARY_PATH=$(DEB_HOST_MULTIARCH) \
		-DFEATURE_webengine_system_ffmpeg=OFF \
		-DFEATURE_webengine_system_icu=ON \
		-DFEATURE_webengine_system_libevent=ON \
		-DFEATURE_webengine_system_libopenjpeg2=ON \
		-DFEATURE_webengine_system_libpng=ON \
		-DFEATURE_webengine_system_libtiff=ON \
		-DFEATURE_webengine_system_libvpx=OFF \
		-DFEATURE_webengine_system_openh264=OFF \
		-DFEATURE_webengine_system_re2=OFF \
		-DFEATURE_qtpdf_build=ON \
		-DFEATURE_qtpdf_widgets_build=ON \
		-DFEATURE_qtpdf_quick_build=ON \
		-DFEATURE_webengine_proprietary_codecs=ON \
		-DFEATURE_webengine_kerberos=ON \
		$(extra_cmake_args)

ifneq ($(filter nodoc,$(DEB_BUILD_PROFILES)),)
override_dh_auto_build:
	dh_auto_build
else
override_dh_auto_build:
	dh_auto_build
	dh_auto_build -- docs
endif

execute_after_dh_auto_install:
	# Reproducible builds: remove build paths from .prl files
	sed -i -e '/^QMAKE_PRL_BUILD_DIR/d' debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/libQt6*.prl
	# Reproducible builds: remove kernel version from build artifacts
	sed -i '/^[[:space:]]*"version":.*deb/d' debian/tmp/usr/lib/${DEB_HOST_MULTIARCH}/qt6/modules/*.json

ifneq ($(filter nodoc,$(DEB_BUILD_PROFILES)),)
	: # docs skipped (nodoc)
else
	DESTDIR=$(CURDIR)/debian/tmp dh_auto_build -- install_docs
	# Remove build path from index files.
	find $(CURDIR)/debian/tmp/usr/share/qt6/doc -type f -name *.index -exec \
               sed -i 's@$(CURDIR)/@@g' {} \; 2>/dev/null || true
endif

override_dh_dwz:
