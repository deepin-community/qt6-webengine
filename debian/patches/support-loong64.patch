+  StackFrameSW* frame1 = static_cast<StackFrameSW*>(frames->at(1));
+  EXPECT_EQ(StackFrame::FRAME_TRUST_SCAN, frame1->trust);
+  ASSERT_EQ((StackFrameSW::CONTEXT_VALID_PC |
+             StackFrameSW::CONTEXT_VALID_SP |
+             StackFrameSW::CONTEXT_VALID_FP |
+             StackFrameSW::CONTEXT_VALID_RA),
+            frame1->context_validity);
+  EXPECT_EQ(return_address - 2 * sizeof(return_address), frame1->context.epc);
+  EXPECT_EQ(frame1_sp.Value(), frame1->context.iregs[MD_CONTEXT_SW_REG_SP]);
+  EXPECT_EQ("marsupial", frame1->function_name);
+  EXPECT_EQ(0x00500100U, frame1->function_base);
