+    StackFrameSW* frame0 = static_cast<StackFrameSW*>(frames->at(0));
+    EXPECT_EQ(StackFrame::FRAME_TRUST_CONTEXT, frame0->trust);
+    ASSERT_EQ(StackFrameSW::CONTEXT_VALID_ALL, frame0->context_validity);
+    EXPECT_EQ("enchiridion", frame0->function_name);
+    EXPECT_EQ(0x00404000U, frame0->function_base);
+
+    StackFrameSW* frame1 = static_cast<StackFrameSW*>(frames->at(1));
+    EXPECT_EQ(StackFrame::FRAME_TRUST_CFI, frame1->trust);
+    ASSERT_EQ(expected_validity, frame1->context_validity);
+    EXPECT_EQ(expected.iregs[MD_CONTEXT_SW_REG_S0],
+              frame1->context.iregs[MD_CONTEXT_SW_REG_S0]);
+    EXPECT_EQ(expected.iregs[MD_CONTEXT_SW_REG_S1],
+              frame1->context.iregs[MD_CONTEXT_SW_REG_S1]);
+    EXPECT_EQ(expected.iregs[MD_CONTEXT_SW_REG_S2],
+              frame1->context.iregs[MD_CONTEXT_SW_REG_S2]);
+    EXPECT_EQ(expected.iregs[MD_CONTEXT_SW_REG_S3],
+              frame1->context.iregs[MD_CONTEXT_SW_REG_S3]);
+    EXPECT_EQ(expected.iregs[MD_CONTEXT_SW_REG_S4],
+              frame1->context.iregs[MD_CONTEXT_SW_REG_S4]);
+    EXPECT_EQ(expected.iregs[MD_CONTEXT_SW_REG_S5],
+              frame1->context.iregs[MD_CONTEXT_SW_REG_S5]);
+    EXPECT_EQ(expected.iregs[MD_CONTEXT_SW_REG_S6],
