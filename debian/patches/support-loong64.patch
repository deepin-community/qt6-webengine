+  kMinidumpContextSW64DSP = kMinidumpContextSW64 | 0x00000008,
+
+  //! \brief Indicates the validity of all registers.
+  kMinidumpContextSW64All = kMinidumpContextSW64Integer |
+                              kMinidumpContextSW64FloatingPoint |
+                              kMinidumpContextSW64DSP,
+};
+
+//! \brief SW64 CPU context (register state) carried in a minidump file.
+struct MinidumpContextSW64 {
+  uint64_t context_flags;
+
+  //! \brief General purpose registers.
+  uint64_t regs[32];
+
+  //! \brief Multiply/divide result.
+  uint64_t mdhi, mdlo;
+
+  //! \brief DSP registers.
+  uint64_t hi[3];
+  uint64_t lo[3];
+  uint64_t dsp_control;
+
+  //! \brief cp0 registers.
+  uint64_t epc;
+  uint64_t badvaddr;
+  uint64_t status;
+  uint64_t cause;
+
+  //! \brief FPU registers.
+  union {
+    struct {
