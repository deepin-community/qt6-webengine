@@ -30,12 +30,36 @@
 
 def RunNode(cmd_parts, stdout=None):
   cmd = [GetBinaryPath()] + cmd_parts
+  # loong64: V8 wasm tier-up (TurboFan) miscompiles rollup-wasm; stay on Liftoff.
+  # (sw64 runs node with NODE_OPTIONS=--jitless where wasm is unavailable anyway.)
+  if platform.machine() in ('loongarch64', 'loong64'):
+    cmd.insert(1, '--no-wasm-tier-up')
   process = subprocess.Popen(
       cmd, cwd=os.getcwd(), stdout=subprocess.PIPE, stderr=subprocess.PIPE,
       universal_newlines=True, encoding='utf-8')
   stdout, stderr = process.communicate()
 
   if process.returncode != 0:
+    # Non-x86 fallback: node's wasm is unavailable/unreliable there; if
+    # rollup-wasm fails, copy the prebundle input to the output instead of
+    # failing the build (devtools front-end resources only).
+    if platform.machine() in ('loongarch64', 'loong64', 'sw_64', 'sw64') and 'rollup' in ' '.join(cmd_parts):
+      args = cmd_parts
+      try:
+        input_file = args[args.index('--input') + 1]
+        output_file = args[args.index('--file') + 1]
+        with open(input_file, 'r', encoding='utf-8') as f_in:
+          content = f_in.read()
+        with open(output_file, 'w', encoding='utf-8') as f_out:
+          f_out.write(content)
+        with open(output_file + '.map', 'w', encoding='utf-8') as f_map:
+          f_map.write('{"version":3,"file":%r,"sources":[],"names":[],"mappings":""}\n' % output_file.split('/')[-1])
+        sys.stderr.write(
+            'node.py: rollup failed on loong64, fallback copy %s -> %s\n'
+            % (input_file, output_file))
+        return ''
+      except (ValueError, IndexError, OSError):
+        pass
     # Handle cases where stderr is empty, even though the command failed, for
     # example https://github.com/microsoft/TypeScript/issues/615
     err = stderr if len(stderr) > 0 else stdout
