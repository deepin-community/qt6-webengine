+    EXPECT_EQ(expected.iregs[MD_CONTEXT_SW_REG_RA],
+              frame1->context.iregs[MD_CONTEXT_SW_REG_RA]);
+    EXPECT_EQ(expected.iregs[MD_CONTEXT_SW_REG_SP],
+              frame1->context.iregs[MD_CONTEXT_SW_REG_SP]);
+    EXPECT_EQ(expected.epc, frame1->context.epc);
+    EXPECT_EQ(expected.epc, frame1->instruction);
+    EXPECT_EQ("epictetus", frame1->function_name);
+    EXPECT_EQ(0x00405000U, frame1->function_base);
+  }
